# ─────────────────────────────────────────────────────────────────
# CivicPulse Frontend — Environment Variables
# Copy this file to .env for local development.
# For Vercel, these same keys go in Dashboard → your project →
# Settings → Environment Variables (NOT read from a committed file).
#
# Vite only exposes variables prefixed with VITE_ to the browser —
# do not rename these or add secrets here, since anything with this
# prefix ships in the public JS bundle. That's expected/fine for the
# three values below; never put an API secret or password in a
# VITE_-prefixed variable.
# ─────────────────────────────────────────────────────────────────

# The backend API's base URL, including the /api suffix.
# Local dev:  http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Must be IDENTICAL to the backend's CLOUDINARY_CLOUD_NAME — the
# backend checks uploaded photo URLs against that value and rejects
# anything that doesn't match.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# An UNSIGNED upload preset created in the Cloudinary dashboard
# (Settings → Upload → Upload presets → Add upload preset → Signing
# Mode: Unsigned). Required for direct browser-to-Cloudinary upload
# without exposing your API secret in the frontend bundle.
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name
